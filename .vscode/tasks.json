{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -TailLog -DelayMs 4000 -Build ${input:build.publish}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch one STS2 instance, tailing the game log. Prompts for the build step (None / Build / Publish; default Publish). Debugger-attachable via 'Launch STS2 + Attach'."
        },
        {
            "label": "MP: Launch",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Players ${input:playerCount} -Build ${input:build.none}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch a host + (N-1) clients for local multiplayer. Prompts for player count and build step (default None)."
        },
        {
            "label": "Debug: Combat",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -WitchBootstrap -TailLog -DelayMs 4000 -Build ${input:build.publish}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 straight into a Witch combat with 100 energy, tailing the game log. Prompts for the build step (default Publish). Debugger-attachable via 'Combat + Attach'."
        },
        {
            "label": "Debug: AutoSlay",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -AutoSlay -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.windowed}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with the AutoSlay smoke-test bot, tailing the game log. Prompts for the build step (default Build) and windowed vs headless. Debugger-attachable via 'AutoSlay + Attach'."
        },
        {
            "label": "Debug: Card Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -CardTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-cardtest: plays every Witch card in a throwaway test combat and logs [witch-cardtest] FAILED lines (grep the tailed log). Prompts for the build step (default Build) and windowed vs headless (default Headless)."
        },
        {
            "label": "Debug: Potion Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -PotionTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-potiontest: procures, uses and discards every Witch potion in a throwaway test combat and logs [witch-potiontest] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless)."
        },
        {
            "label": "Debug: Relic Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -RelicTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-relictest: equips EVERY Witch relic, then plays every card and uses every potion in throwaway test combats and logs [witch-relictest] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless)."
        },
        {
            "label": "Debug: Test All",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -TestAll -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-testall: runs the card, potion and relic smoke tests back to back in one process and logs [witch-testall] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless)."
        },
        {
            "label": "Debug: FX Lab",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -FxLab -TailLog -DelayMs 4000 -Build ${input:build.build}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 into the SFX/VFX browser scene, tailing the game log. Prompts for the build step (default Build). Debugger-attachable via 'FX Lab + Attach'."
        },
        {
            "label": "Debug: FX Lab + Combat",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch-witch.ps1' -Solo -FxLab -DelayMs 2000 -Build ${input:build.publish}; & '${workspaceFolder}/tools/launch-witch.ps1' -Solo -WitchBootstrap -TailLog -DelayMs 4000"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch TWO STS2 instances: FX Lab first, then Witch combat (tailing its log) — VFX iteration with a live combat reference. Prompts for the build step (default Publish; applied once, before the first launch)."
        },
        {
            "label": "Godot: Import assets",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/import-assets.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Headless Godot --import: generate .import sidecars for new pngs (card portraits, etc.)."
        },
        {
            "label": "Images: Generate missing sizes",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/gen-image-sizes.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Fill missing big/small variants of card_portraits & powers (upscale small->big, downscale big->small, 4x). Run 'Godot: Import assets' after."
        },
        {
            "label": "VFX: Pack sprite sheets",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/pack-atlases.py",
                "--vfx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Pack each TheWitch/images/vfx/raw/<name>/ folder into a power-of-two sprite sheet at images/vfx/sheets/<name>.png (tracked; prints hframes/vframes). Also runs the regular atlas pack."
        },
        {
            "label": "Images: Generate locked char-select silhouette",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/gen-locked-silhouette.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Regenerate char_select_char_name_locked.png as a flat silhouette of char_select_char_name.png (alpha shape, or background colour-key for full-bleed art)."
        },
        {
            "label": "dotnet build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "TheWitch.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "dotnet publish",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "TheWitch.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Workshop: Bundle",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/bundle-workshop.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "dotnet publish (export .pck) + stage the mod into workshop/content. Run before deploying; does NOT upload."
        },
        {
            "label": "Workshop: Deploy (upload to Steam)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/bundle-workshop.ps1",
                "-SkipPublish",
                "-Upload",
                "-ChangeNote",
                "${input:changeNote}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Workshop: Bundle",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Bundle, then upload to the Steam Workshop. Requires Steam running & logged in. First upload creates a new item and writes workshop/mod_id.txt (commit it)."
        },
        {
            "label": "Card Data: Regen",
            "type": "process",
            "command": "node",
            "args": [
                "${workspaceFolder}/Docs/card-data/regen.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Rebuild Docs/card-data/cards.json from the card .cs files + localization, then regenerate pages/art-tracker.html."
        },
        {
            "label": "Card Designs: Serve",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/card-designs-serve.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Start the card design page server (http://localhost:7820) and open it in the browser. Stop with 'Card Designs: Stop'."
        },
        {
            "label": "Art Tracker: Open",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process '${workspaceFolder}/pages/art-tracker.html'"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            },
            "detail": "Open the local art tracker page (pages/art-tracker.html) in the default browser. Live copy: https://joytis.github.io/TheWicken/pages/art-tracker.html"
        },
        {
            "label": "Card Designs: Stop",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/card-designs-stop.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Stop the card design server (kills the node process on port 7820)."
        },
        {
            "label": "Analytics: Export web stats",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/analytics/analytics.ps1",
                "-Mode",
                "export"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Pull runs from Supabase and regenerate pages/analytics-data/*.json for the dashboard (same script CI runs nightly)."
        },
        {
            "label": "Analytics: Serve dashboard",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process 'http://localhost:7821/pages/analytics.html'; py -m http.server 7821 --directory '${workspaceFolder}'"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Serve the repo on http://localhost:7821 and open the analytics dashboard (fetch needs http, not file://). Terminate the task to stop. Live copy: https://joytis.github.io/TheWicken/pages/analytics.html"
        }
    ],
    "inputs": [
        {
            "id": "playerCount",
            "type": "promptString",
            "description": "Total players to launch (1 host + rest clients)",
            "default": "2"
        },
        {
            "id": "changeNote",
            "type": "promptString",
            "description": "Steam Workshop change note for this upload (blank = leave unchanged)",
            "default": ""
        },
        {
            "id": "build.none",
            "type": "pickString",
            "description": "Build step before launching?",
            "options": [
                {
                    "label": "None (use what's deployed)",
                    "value": "none"
                },
                {
                    "label": "Build (dotnet build: dll + json)",
                    "value": "build"
                },
                {
                    "label": "Publish (dotnet publish: dll + .pck assets)",
                    "value": "publish"
                }
            ],
            "default": "none"
        },
        {
            "id": "build.build",
            "type": "pickString",
            "description": "Build step before launching?",
            "options": [
                {
                    "label": "None (use what's deployed)",
                    "value": "none"
                },
                {
                    "label": "Build (dotnet build: dll + json)",
                    "value": "build"
                },
                {
                    "label": "Publish (dotnet publish: dll + .pck assets)",
                    "value": "publish"
                }
            ],
            "default": "build"
        },
        {
            "id": "build.publish",
            "type": "pickString",
            "description": "Build step before launching?",
            "options": [
                {
                    "label": "None (use what's deployed)",
                    "value": "none"
                },
                {
                    "label": "Build (dotnet build: dll + json)",
                    "value": "build"
                },
                {
                    "label": "Publish (dotnet publish: dll + .pck assets)",
                    "value": "publish"
                }
            ],
            "default": "publish"
        },
        {
            "id": "headless.windowed",
            "type": "pickString",
            "description": "Windowed or headless (no window/GPU)?",
            "options": [
                {
                    "label": "Windowed",
                    "value": ""
                },
                {
                    "label": "Headless",
                    "value": "-Headless"
                }
            ],
            "default": ""
        },
        {
            "id": "headless.headless",
            "type": "pickString",
            "description": "Windowed or headless (no window/GPU)?",
            "options": [
                {
                    "label": "Windowed",
                    "value": ""
                },
                {
                    "label": "Headless",
                    "value": "-Headless"
                }
            ],
            "default": "-Headless"
        }
    ]
}
